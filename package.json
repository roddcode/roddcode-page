{
  "name": "roddcode",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@9.5.0",
  "browserslist": [
    "chrome >= 111",
    "edge >= 111",
    "firefox >= 111",
    "safari >= 16.4"
  ],
  "scripts": {
    "dev": "next dev --webpack",
    "dev:turbo": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "biome check src scripts tests",
    "format": "biome format --write src scripts tests",
    "check": "biome check --write src scripts tests",
    "typecheck": "tsc --noEmit",
    "test": "playwright test tests/layout.spec.ts",
    "clean": "node -e \"const f=require('node:fs');for(const d of ['.next','.turbo'])f.rmSync(d,{recursive:true,force:true})\"",
    "logos": "node scripts/optimize-logos.mjs",
    "og:contour": "node scripts/og-contour.mjs"
  },
  "dependencies": {
    "@tailwindcss/typography": "0.5.20",
    "@vercel/analytics": "2.0.1",
    "@vercel/speed-insights": "2.0.0",
    "clsx": "^2.1.1",
    "gray-matter": "4.0.3",
    "lucide-react": "1.16.0",
    "next": "^16.4.4",
    "next-intl": "4.14.9",
    "next-mdx-remote": "6.0.0",
    "radix-ui": "1.8.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "rehype-pretty-code": "0.14.3",
    "tailwind-merge": "^2.6.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@biomejs/biome": "^1.9.4",
    "@playwright/test": "1.64.1",
    "@tailwindcss/postcss": "4.3.0",
    "@types/node": "^20.19.43",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "critters": "0.0.25",
    "sharp": "0.35.5",
    "tailwindcss": "4.3.0",
    "typescript": "^5.9.3"
  },
  "pnpm": {
    "overrides": {
      "@tailwindcss/typography>postcss-selector-parser": "^6.1.5"
    }
  }
}
